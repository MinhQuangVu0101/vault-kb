{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.js", "scripts/**/*.js"]
}
